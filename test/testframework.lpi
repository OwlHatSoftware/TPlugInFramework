<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="testframework"/>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes>
      <Item Name="default" Default="True"/>
    </BuildModes>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="ohspluginframework_multigrid"/>
        <DefaultFilename Value="..\packages\lazarus\ohspluginframework_multigrid.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="ohspluginframework"/>
        <DefaultFilename Value="..\packages\lazarus\ohspluginframework.lpk" Prefer="True"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="testframework.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="testframework"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
  </CompilerOptions>
</CONFIG>

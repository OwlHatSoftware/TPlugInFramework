<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{E02F9497-5B99-43EA-9278-042D886A18BF}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="HostApp\HostApp.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="DLL1\PluginDLL1.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="DLL2\PluginDLL2.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="HostApp">
        <MSBuild Projects="HostApp\HostApp.dproj"/>
    </Target>
    <Target Name="HostApp:Clean">
        <MSBuild Projects="HostApp\HostApp.dproj" Targets="Clean"/>
    </Target>
    <Target Name="HostApp:Make">
        <MSBuild Projects="HostApp\HostApp.dproj" Targets="Make"/>
    </Target>
    <Target Name="PluginDLL1">
        <MSBuild Projects="DLL1\PluginDLL1.dproj"/>
    </Target>
    <Target Name="PluginDLL1:Clean">
        <MSBuild Projects="DLL1\PluginDLL1.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PluginDLL1:Make">
        <MSBuild Projects="DLL1\PluginDLL1.dproj" Targets="Make"/>
    </Target>
    <Target Name="PluginDLL2">
        <MSBuild Projects="DLL2\PluginDLL2.dproj"/>
    </Target>
    <Target Name="PluginDLL2:Clean">
        <MSBuild Projects="DLL2\PluginDLL2.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PluginDLL2:Make">
        <MSBuild Projects="DLL2\PluginDLL2.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="HostApp;PluginDLL1;PluginDLL2"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="HostApp:Clean;PluginDLL1:Clean;PluginDLL2:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="HostApp:Make;PluginDLL1:Make;PluginDLL2:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>

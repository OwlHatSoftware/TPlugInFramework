<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="ohsPluginFramework demo"/>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes>
      <Item Name="default" Default="True"/>
    </BuildModes>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="ohspluginframework_gantt"/>
        <DefaultFilename Value="..\..\..\packages\lazarus\ohspluginframework_gantt.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="ohspluginframework_ribbon"/>
        <DefaultFilename Value="..\..\..\packages\lazarus\ohspluginframework_ribbon.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="ohspluginframework_fresnel"/>
        <DefaultFilename Value="..\..\..\packages\lazarus\ohspluginframework_fresnel.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="ohspluginframework"/>
        <DefaultFilename Value="..\..\..\packages\lazarus\ohspluginframework.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="GanttComponents"/>
      </Item>
      <Item>
        <PackageName Value="ohsribbon"/>
      </Item>
      <Item>
        <PackageName Value="Fresnel"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="ohsplugindemo.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="hostform.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Conditionals Value="// Find libsk4d.so next to the program, wherever it is started from.
if TargetOS='linux' then
  CustomOptions := '-k-rpath -k$ORIGIN';"/>
    <Target>
      <Filename Value="..\out\$(TargetCPU)-$(TargetOS)\ohsplugindemo"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
  </CompilerOptions>
</CONFIG>
